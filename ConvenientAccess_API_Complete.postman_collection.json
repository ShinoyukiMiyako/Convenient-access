    {
      "name": "玩家与服务器",
      "description": "玩家数据在服务器主线程采集, 有并发与超时限制。",
      "item": [
        {
          "name": "在线玩家数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/player?name={{player_name}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "player"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{player_name}}"
                }
              ]
            },
            "description": "并发上限 5, 超出返回 429; 主线程繁忙返回 504。"
          },
          "response": []
        },
        {
          "name": "离线玩家数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/player?name={{player_name}}&includeOffline=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "player"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{player_name}}"
                },
                {
                  "key": "includeOffline",
                  "value": "true"
                }
              ]
            },
            "description": "读取 playerdata 下的 NBT, 部分运行期字段缺席。"
          },
          "response": []
        },
        {
          "name": "在线玩家列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/server/players",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "server",
                "players"
              ]
            },
            "description": "名字、UUID、维度、坐标、生命、延迟、游戏模式。"
          },
          "response": []
        },
